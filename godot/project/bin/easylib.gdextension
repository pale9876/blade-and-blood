[configuration]

entry_symbol = "cpp_easylib"
compatibility_minimum = "4.6"
reloadable = true

[libraries]

macos.debug = "./cppeasylibs.macos.template_debug.dylib"
macos.release = "./cppeasylibs.macos.template_release.dylib"
windows.editor.x86_64 = "./cppeasylibs.windows.editor.x86_64.dll"
windows.debug.x86_32 = "./cppeasylibs.windows.template_debug.x86_32.dll"
windows.release.x86_32 = "./cppeasylibs.windows.template_release.x86_32.dll"
windows.debug.x86_64 = "./cppeasylibs.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "./cppeasylibs.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "./cppeasylibs.linux.template_debug.x86_64.so"
linux.release.x86_64 = "./cppeasylibs.linux.template_release.x86_64.so"
linux.debug.arm64 = "./cppeasylibs.linux.template_debug.arm64.so"
linux.release.arm64 = "./cppeasylibs.linux.template_release.arm64.so"
linux.debug.rv64 = "./cppeasylibs.linux.template_debug.rv64.so"
linux.release.rv64 = "./cppeasylibs.linux.template_release.rv64.so"